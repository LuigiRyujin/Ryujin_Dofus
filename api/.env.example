DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full
PORT=3000
ANKABOT_SESSION_EXPIRATION_INTERVAL_MS=60000
# Operator token: >=32 characters, kept private in Desktop secure storage.
OPERATOR_TOKEN=
# Distinct token restricted to character queries and status changes.
ANKABOT_TOKEN=
# Base64 encoding of exactly 32 cryptographically random bytes.
CREDENTIALS_KEY=
APIMAIL_TOKEN=
# Populate from the verified Dofus Touch runtime catalog. No PC catalog defaults.
CHARACTER_OPTIONS_JSON={"breeds":[],"servers":[]}
